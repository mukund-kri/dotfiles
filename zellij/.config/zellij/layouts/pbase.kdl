layout {
    pane split_direction="vertical" {
        pane cwd="/home/mukund/workarea/productivity/what-i-have-to-do" name="tolaria" command="zsh" {
            args "-c" "~/bin/tolaria; exec zsh"
        }
        pane cwd="/home/mukund/workarea/productivity/what-i-have-to-do" name="codium" command="zsh" {
            args "-c" "codium . && exec zsh"
        }
    }
}

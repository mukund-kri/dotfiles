layout {
    pane split_direction="vertical" {
        pane cwd="/home/mukund/workarea/getforj/utils/orchestrator-socket-io-simulator" name="orchestrator-simulator" command="zsh" focus=true {
            args "-c" "go build -o simulator . && ./simulator; exec zsh"
        }
        pane cwd="/home/mukund/workarea/getforj/core/fit-customer-app" name="fit-customer-app" command="zsh" {
            args "-c" "VITE_ORCH_BASE_URL=http://localhost:3300 npm run simulate; exec zsh"
        }
    }
}
